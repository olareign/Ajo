# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# These are read on the server only (the BFF in src/server/); nothing here is exposed to the browser,
# so none of them may start with NEXT_PUBLIC_.

# Base URL of the Àjọ API (the ajo-api NestJS service), without a trailing path.
#   Local:      http://localhost:4000   (the default when unset in development)
#   Production: must be https, e.g. the Render service URL.
API_BASE_URL=http://localhost:4000

# Encrypts the session cookie (iron-session). At least 32 characters; generate with:
#   openssl rand -base64 48
# Development falls back to a random per-process secret, so sessions end whenever the dev server
# restarts; set a fixed value here to stay signed in. Production refuses to start without it.
# Changing it signs everyone out.
SESSION_SECRET=

# Cloudflare Turnstile's PUBLIC site key for the sign-up check (the matching secret key lives on the API
# only, as TURNSTILE_SECRET_KEY). Leave empty locally: the form then shows no check. To try the real widget
# without a real account, Cloudflare publishes test keys; "1x00000000000000000000AA" always passes.
TURNSTILE_SITE_KEY=
